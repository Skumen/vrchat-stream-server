#!/usr/bin/env bash
# Подставной pgrep: «идёт unattended-upgrade» столько проверок, сколько записано в
# $MOCK_STATE/apt_busy (считается вызов с -f); apt/dpkg по имени (-x) — не заняты
[[ " $* " == *" -f "* ]] || exit 1
n=$(cat "$MOCK_STATE/apt_busy" 2>/dev/null || echo 0)
(( n > 0 )) || exit 1
echo $(( n - 1 )) > "$MOCK_STATE/apt_busy"
echo 6953
