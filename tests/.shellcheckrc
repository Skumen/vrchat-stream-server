# shellcheck для тестов. Тесты подключают setup.sh и нарочно переопределяют его функции
# и переменные внутри подоболочек ( … ) — shellcheck считает это ошибками, хотя это не так:
#   SC2034 переменная «не используется» — её использует подключённый setup.sh
#   SC2329 функция «не вызывается» — её вызывает функция setup.sh (подставные curl, exec…)
#   SC2030/SC2031 изменение переменной в подоболочке — так и задумано, для изоляции
#   SC2016 $ в одинарных кавычках — это регулярные выражения и тексты, не подстановки
source-path=SCRIPTDIR
source-path=SCRIPTDIR/..
external-sources=true
disable=SC2034,SC2329,SC2030,SC2031,SC2016
